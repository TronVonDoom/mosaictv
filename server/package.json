    "prisma": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
